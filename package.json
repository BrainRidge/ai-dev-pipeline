{
  "name": "ai-dev-pipeline",
  "version": "0.10.0",
  "private": true,
  "description": "AI Dev Pipeline: one workflow engine, one renderer, two IDE plugins.",
  "workspaces": [
    "tool/core",
    "tool/vscode-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "npm run typecheck && npm run lint && npm test && npm run check:parity",
    "typecheck": "npm run typecheck -w @ai-dev-pipeline/core -w ai-dev-workflow",
    "test": "npm test -w @ai-dev-pipeline/core",
    "lint": "eslint .",
    "check:parity": "node scripts/check-parity.mjs",
    "build": "npm run build:vscode && npm run build:intellij",
    "build:core": "npm run build -w @ai-dev-pipeline/core",
    "build:renderer": "npm run build:renderer -w @ai-dev-pipeline/core",
    "build:sidecar": "npm run build:sidecar -w @ai-dev-pipeline/core",
    "build:vscode": "npm run build:renderer && npm run build -w ai-dev-workflow",
    "build:intellij": "tool/intellij-plugin/gradlew -p tool/intellij-plugin buildPlugin",
    "watch": "npm run watch -w ai-dev-workflow",
    "package": "npm run package:vscode && npm run package:intellij",
    "package:vscode": "npm run package -w ai-dev-workflow",
    "package:intellij": "tool/intellij-plugin/gradlew -p tool/intellij-plugin buildPlugin",
    "compile:test": "npm run compile:test -w ai-dev-workflow",
    "test:integration": "npm run test:integration -w ai-dev-workflow",
    "check:package": "npm run check:package -w ai-dev-workflow",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
