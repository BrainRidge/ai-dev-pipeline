{
  "name": "@ai-dev-pipeline/core",
  "version": "0.10.0",
  "private": true,
  "description": "IDE-independent workflow engine, renderer and content. Imports no IDE API.",
  "type": "commonjs",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test",
    "build:sidecar": "node esbuild.sidecar.mjs",
    "build:renderer": "node esbuild.renderer.mjs",
    "build": "npm run build:renderer && npm run build:sidecar"
  },
  "dependencies": {
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
